# Copy to .env and fill in. .env is gitignored.

# Local PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=

# AI providers. Either a single key or a comma-separated pool.
GEMINI_API_KEY=
GEMINI_API_KEYS=
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=

# Optional overrides
# AI_PROVIDER=fallback
# CORS_ALLOWED_ORIGINS=http://localhost:5173
